# Remove default binding for new window (Ctrl+Shift+N)
keybind = ctrl+shift+n=unbind

# Background image
background-image = ~/.dotfiles/pics/omao-shaded-gradient.png
background-image-opacity = 1.0
background-image-fit = cover
background-image-fit = stretch
background-image-position = center
background-opacity = 1.0

# Theme
theme = Monokai SublimeText
theme = Gruvbox Dark
theme = Wez

# Font
font-family = JetBrainsMono Nerd Font
font-size = 13
font-feature = -calt
font-feature = -clig
font-feature = -liga

# Window size
initial-window = true
window-width = 120
window-height = 28

# Window padding
window-padding-balance = false
window-padding-color = extend
window-padding-color = extend-always
# window-padding-coloR = background
window-padding-x = 2
window-padding-y = 0

# Window decorations
window-decoration = auto
macos-titlebar-style = hidden
window-step-resize = true

# Keyboard
macos-option-as-alt = left
keybind = alt+left=unbind
keybind = alt+right=unbind

